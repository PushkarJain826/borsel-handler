# =============================================================================
# Borsel Handler — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit the .env file.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Borsel Handler
DEBUG=false

# ── PostgreSQL / TimescaleDB ─────────────────────────────────────────────────
POSTGRES_USER=borsel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=borsel
DATABASE_URL=postgresql+asyncpg://borsel:changeme@db:5432/borsel

# ── Redis (Celery broker) ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Storage paths (relative to project root inside container) ────────────────
STORAGE_RAW_DIR=storage/raw
STORAGE_EXTRACTED_DIR=storage/extracted
STORAGE_PROCESSED_DIR=storage/processed
STORAGE_QUARANTINE_DIR=storage/quarantine
LOG_DIR=storage/logs
